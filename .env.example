# Copie para .env na VPS e preencha os valores privados.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS_ENABLED=true
DJANGO_SECURE_HSTS_SECONDS=0
POSTGRES_PASSWORD=
WEB_PORT=8000

# Origem legada (SQL Server): deixar vazia até confirmar conectividade.
DB_DRIVER=
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASS=
LEGACY_DATABASE_VIEW=VW_FIN_BOL_A
LEGACY_COLLECTION_YEAR=2026

# SMTP: 587/TLS ou 465/SSL. Nunca habilite os dois.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=no-reply@novane.com.br
SMTP_PASSWORD=
SMTP_USE_TLS=
SMTP_USE_SSL=
DEFAULT_FROM_EMAIL=no-reply@novane.com.br
